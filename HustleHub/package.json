{
  "name": "hustlehub-part1",
  "version": "1.0.0",
  "private": true,
  "description": "HustleHub+ Part 1 secure backend foundations",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "node --env-file=.env src/server.cjs",
    "dev": "node --watch --env-file=.env src/server.cjs",
    "test": "node --test test/*.test.cjs",
    "test:postman": "node --env-file=.env scripts/run-postman.cjs",
    "postman:build": "node scripts/build-collection.cjs",
    "seed:dev": "node --env-file=.env scripts/seed-dev-gigs.cjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.2"
  }
}
