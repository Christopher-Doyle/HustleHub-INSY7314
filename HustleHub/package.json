    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "newman": "^6.2.3",
    "yaml": "^2.9.1"
  }
}
