    "postman:build": "node scripts/build-collection.cjs",
    "openapi:validate": "node scripts/validate-openapi.cjs",
    "security:server": "node scripts/security-test-server.cjs",
    "smoke:atlas": "node --env-file=.env scripts/smoke-atlas.cjs",
