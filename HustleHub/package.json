{
  "name": "hustlehub-plus-part2",
  "version": "1.0.0",
  "private": true,
  "description": "HustleHub+ Part 2 secure freelance marketplace",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/setup.cjs",
    "start": "node --env-file=.env src/server.cjs",
    "dev": "node --watch --env-file=.env src/server.cjs",
