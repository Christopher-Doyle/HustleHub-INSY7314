{
  "info": {
    "name": "HustleHub+ | Part 1 Secure Foundations",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order. Request 01 generates a unique test email for every run. Request 04 saves the JWT; request 05 uses it. Trust certs/localhost.pem in Postman before running. All credentials are disposable test data. Backend uses in-memory storage. Repeated runs within 15 minutes can trigger the 30-attempt rate limit; restart the local demo server or wait."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:4000"
    },
    {
      "key": "testEmail",
      "value": ""
    },
    {
      "key": "testPassword",
      "value": "DemoPassphrase!7314"
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - HTTPS health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health",
        "description": "Expected status: 200. ",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Consistent response', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('No credentials leaked', () => { const json = pm.response.json(); const user = json.data && json.data.user; if (user) { pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); } pm.expect(json).not.to.have.property('stack'); });",
              "pm.test('HTTPS URL', () => pm.expect(pm.variables.replaceIn(pm.request.url.toString())).to.match(/^https:/));"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('testEmail', 'aisha.' + pm.variables.replaceIn('{{$guid}}') + '@example.com');",
              "pm.collectionVariables.unset('accessToken');"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Register freelancer",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/auth/register",
        "description": "Expected status: 201. ",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fullName\": \"Aisha Khan\",\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\",\n  \"role\": \"freelancer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('JSON response', () => pm.response.to.be.json);",
              "pm.test('Consistent response', () => pm.expect(pm.response.json().success).to.eql(true));",
              "pm.test('No credentials leaked', () => { const json = pm.response.json(); const user = json.data && json.data.user; if (user) { pm.expect(user).not.to.have.property('password'); pm.expect(user).not.to.have.property('passwordHash'); } pm.expect(json).not.to.have.property('stack'); });",
              "pm.test('Freelancer created', () => pm.expect(pm.response.json().data.user.role).to.eql('freelancer'));",
              "pm.collectionVariables.set('userId', pm.response.json().data.user.id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Duplicate email",
